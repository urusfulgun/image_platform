livedebugging {
  enabled = true
}

// 1. Discover all Docker containers
discovery.docker "all_containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Collect logs and send to Relabeling
loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.all_containers.targets
  forward_to = [loki.relabel.journal_relabel.receiver]
}

// 3. Relabeling: Clean up service names
loki.relabel "journal_relabel" {
  forward_to = [loki.process.filter_logs.receiver] // Now pointing to Process

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
    replacement   = "$1"
  }
}

// 4. Processing: Conditional DROP based on Service Name
loki.process "filter_logs" {
  forward_to = [loki.write.local_loki.receiver]

  // First, target ONLY the kafka container
  stage.match {
    selector = "{service_name=\"kafka\"}"

    // Inside this match, drop the specific heartbeat lines
    stage.drop {
      expression = "(?i).*(heartbeat|fetch session|group coordinator).*"
    }
  }

  // You can add more match blocks here for other services
  stage.match {
    selector = "{service_name=\"debezium-connector\"}"
    stage.drop {
      expression = ".*Checking for change events.*"
    }
  }
  stage.match {
    selector = "{service_name=\"nginx-proxy\"}"
    stage.drop {
      expression = ".*Checking for change events.*"
    }
  }
}

// 5. Define final destination (Loki)
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
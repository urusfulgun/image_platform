// 1. Discover all Docker containers
discovery.docker "all_containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Relabeling Block: This "cleans" the metadata
loki.relabel "journal_relabel" {
  forward_to = [loki.write.local_loki.receiver]

  // Rule: Take the Docker container name metadata
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"   // Docker names start with '/', this removes it
    target_label  = "service_name"
    replacement   = "$1"
  }
}

// 3. Collect logs and send them to the RELABEL block first
loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.all_containers.targets
  forward_to = [loki.relabel.journal_relabel.receiver] // Now pointing to relabel
}

// 4. Define the final destination (Loki)
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
livedebugging {
  enabled = true
}
// 1. Connect to Docker via the mounted socket to find all running containers
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

// 2. Extract useful labels from Docker and point Alloy to the physical log files
discovery.relabel "local" {
  targets = discovery.docker.local.targets

  // Grab the Docker Compose service name (e.g., 'asset-service', 'kafka')
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  // Grab the raw container name, stripping the leading slash Docker adds
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Construct the absolute path to the Docker json-file log on disk
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "__path__"
    replacement   = "/var/lib/docker/containers/$1/$1-json.log"
  }
}

// 3. Read the actual log files from the mounted directory
loki.source.file "local" {
  targets    = discovery.relabel.local.output
  forward_to = [loki.process.parse_docker.receiver]
}

// 4. Parse the Docker JSON wrapper to extract the raw log line, stream (stdout/stderr), and timestamp
loki.process "parse_docker" {
  forward_to = [loki.write.default.receiver]

  stage.docker { }
}

// 5. Send the clean, labeled logs to the Loki container
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
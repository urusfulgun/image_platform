livedebugging {
  enabled = true
}

// 1. Discover all Docker containers
discovery.docker "all_containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Collect logs
loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock" // This must be present
  targets    = discovery.docker.all_containers.targets
  forward_to = [loki.relabel.journal_relabel.receiver]
}

// 3. Relabeling: Move internal metadata to permanent labels
loki.relabel "journal_relabel" {
  forward_to = [loki.process.filter_logs.receiver]

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

// 4. Processing: Filtering and Noise Reduction
loki.process "filter_logs" {
  forward_to = [loki.write.local_loki.receiver]

  // Global Drop for Healthchecks/Pings
  stage.drop {
    expression = "(?i).*(GET /health|GET /ready|GET /misc/ping|pg_isready|HTTP/1.1 200 OK).*"
  }

  // Service Specific: Kafka Noise
  stage.match {
    selector = "{container=\"kafka\"}"
    stage.drop {
      expression = "(?i).*(heartbeat|fetch session|group coordinator).*"
    }
  }

  // Service Specific: Debezium Noise
  stage.match {
    selector = "{container=\"debezium-connector\"}"
    stage.drop {
      expression = ".*Checking for change events.*"
    }
  }
}

// 5. Final Destination
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}